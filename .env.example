# ---- Database (server-only) ----
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---- Payments (server-only) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Realtime activity feed (public, optional) ----
# Only the anon key belongs here. Without these the feed renders a server
# snapshot instead of subscribing to live inserts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Third-party analytics (public, optional) ----
# Public dashboard URL linked from /stats, e.g. Plausible or Vemetric.
NEXT_PUBLIC_ANALYTICS_URL=
